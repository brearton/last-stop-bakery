# Last Stop Bakery & Mercantile — Square credentials for data pulls & growth planning
# Copy this file to .env (which is gitignored) and fill in your values.

# REQUIRED: Personal access token from Square Developer Dashboard
# Get it here: https://developer.squareup.com/apps  (sign in with the bakery's Square login)
# Start with the SANDBOX token for safe testing. Switch to Production token for real data.
SQUARE_ACCESS_TOKEN=PASTE_YOUR_TOKEN_HERE

# Environment: Sandbox (safe, test data) or Production (your live account)
SQUARE_ENVIRONMENT=Sandbox

# Optional: If you have multiple locations, specify the one to query.
# You can discover IDs by running the pull script (it lists all locations).
# SQUARE_LOCATION_ID=your-location-id-here

# Live menu hub (Google Apps Script web app URL from your sheet)
# This is the "live hub" that always reflects the latest Google Sheet edits.
# Get it by deploying the Apps Script as Web App (see README or scripts/sync-square-menu.js comments).
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_WEB_APP_ID/exec
